@mode(host.dual)

# Command-line parsing for wc, following GNU getopt_long: short options may
# be combined (`-lw`), options and operands may be mixed, `--` ends the
# options, a lone `-` is an operand (standard input), and a long option may
# be abbreviated to any unique prefix (`--max`, `--tot=al`).

pub const TOTAL_AUTO: int = 0;
pub const TOTAL_ALWAYS: int = 1;
pub const TOTAL_ONLY: int = 2;
pub const TOTAL_NEVER: int = 3;

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub lines: bool;
    pub words: bool;
    pub chars: bool;
    pub bytes: bool;
    pub max_line: bool;
    pub total: int;
    pub operands: list[string];
}

# wc's long options, in GNU's order (the order of an ambiguity message).
pub func long_names(): list[string] {
    return ["bytes", "chars", "lines", "words", "max-line-length", "total", "help", "version"];
}

# Resolves the name of a long option (`given`, without `--` or `=VALUE`)
# against `names` as getopt_long does: an exact name wins, otherwise the
# name must be the prefix of exactly one option. `arg` is the argument as
# typed, for the error message.
pub func match_long(given: string, arg: string, names: list[string]): Result[string, string] {
    var found: list[string] = [];
    for (name in names) {
        if (name == given) {
            return Ok(name);
        }
        if (name.startsWith(given)) {
            found.push(name);
        }
    }
    if (found.len() == 1) {
        return Ok(found[0]);
    }
    if (found.len() == 0) {
        return Err(i"unrecognized option '{$ arg $}'");
    }
    var listed: list[string] = [];
    for (name in found) {
        listed.push(i"'--{$ name $}'");
    }
    return Err(i"option '{$ arg $}' is ambiguous; possibilities: {$ listed.join(" ") $}");
}

# The value of `--total=WHEN` as GNU's argmatch reads it: `auto`, `always`,
# `only` or `never`, or a unique prefix of one.
pub func parse_total(when: string): Result[int, string] {
    let names = ["auto", "always", "only", "never"];
    var found: list[int] = [];
    for (k in 0..names.len()) {
        if (names[k] == when) {
            return Ok(k);
        }
        if (names[k].startsWith(when)) {
            found.push(k);
        }
    }
    if (found.len() == 1) {
        return Ok(found[0]);
    }
    let kind = if (found.len() == 0) { "invalid" } else { "ambiguous" };
    let lines = [
        kind + " argument '" + when + "' for '--total'",
        "Valid arguments are:",
        "  - 'auto'",
        "  - 'always'",
        "  - 'only'",
        "  - 'never'",
    ];
    return Err(lines.join("\n"));
}

pub func parse_args(argv: list[string]): Result[Options, string] {
    var help = false;
    var version = false;
    var lines = false;
    var words = false;
    var chars = false;
    var bytes = false;
    var max_line = false;
    var total = TOTAL_AUTO;
    var operands: list[string] = [];
    var only_operands = false;
    var i = 0;

    while (i < argv.len() and !help and !version) {
        let arg = argv[i];
        i += 1;
        if (only_operands or arg == "-" or !arg.startsWith("-")) {
            operands.push(arg);
        } else if (arg == "--") {
            only_operands = true;
        } else if (arg.startsWith("--")) {
            let body = arg.slice(2);
            let eq = body.index_of("=");
            let given = if (eq >= 0) { body.slice(0, eq) } else { body };
            let name = match match_long(given, arg, long_names()) {
                Ok(found) => found,
                Err(msg) => {
                    return Err(msg);
                },
            };
            if (name == "total") {
                var when = "";
                if (eq >= 0) {
                    when = body.slice(eq + 1);
                } else if (i < argv.len()) {
                    when = argv[i];
                    i += 1;
                } else {
                    return Err("option '--total' requires an argument");
                }
                total = match parse_total(when) {
                    Ok(t) => t,
                    Err(msg) => {
                        return Err(msg);
                    },
                };
            } else if (eq >= 0) {
                return Err(i"option '--{$ name $}' doesn't allow an argument");
            } else if (name == "bytes") {
                bytes = true;
            } else if (name == "chars") {
                chars = true;
            } else if (name == "lines") {
                lines = true;
            } else if (name == "words") {
                words = true;
            } else if (name == "max-line-length") {
                max_line = true;
            } else if (name == "help") {
                help = true;
            } else {
                version = true;
            }
        } else {
            for (letter in arg.slice(1)) {
                if (letter == "c") {
                    bytes = true;
                } else if (letter == "m") {
                    chars = true;
                } else if (letter == "l") {
                    lines = true;
                } else if (letter == "w") {
                    words = true;
                } else if (letter == "L") {
                    max_line = true;
                } else {
                    return Err(i"invalid option -- '{$ letter $}'");
                }
            }
        }
    }

    # Without a count option, wc prints lines, words and bytes.
    if (!(lines or words or chars or bytes or max_line)) {
        lines = true;
        words = true;
        bytes = true;
    }
    return Ok(Options(
        help = help,
        version = version,
        lines = lines,
        words = words,
        chars = chars,
        bytes = bytes,
        max_line = max_line,
        total = total,
        operands = operands,
    ));
}
