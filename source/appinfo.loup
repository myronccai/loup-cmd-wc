@mode(host.dual)

# Application identity for wc: name, version, summary and exit statuses.
# Keep APP_NAME and APP_VERSION in step with `name` and `version` in
# package.lppkg.
#
# Runtime: host.dual. Constants only. Compiled into build/wc by `make
# build`; `loup run source/main.loup` interprets the same code.

pub const APP_NAME: string = "wc";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Print newline, word, character and byte counts (a Loup recreation of GNU wc).";

# Exit statuses returned by main(). GNU wc reports usage errors with
# status 1, the same as a missing file.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
pub const EXIT_USAGE: int = 1;
