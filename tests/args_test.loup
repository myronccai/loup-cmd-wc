@mode(host.dual)

from debug.assert import (expect, expectEq);
from cli.args import (parse_args, parse_total, match_long, long_names, TOTAL_AUTO, TOTAL_ALWAYS, TOTAL_ONLY, TOTAL_NEVER);

func test_default_counts(): void {
    let none: list[string] = [];
    let opts = parse_args(none).unwrap();
    expect(opts.lines and opts.words and opts.bytes, "lines, words, bytes");
    expect(!opts.chars and !opts.max_line, "not chars or -L");
    expectEq(opts.total, TOTAL_AUTO, "total when several files");
}

func test_selected_counts(): void {
    let opts = parse_args(["-lm", "f"]).unwrap();
    expect(opts.lines and opts.chars, "-lm");
    expect(!opts.words and !opts.bytes and !opts.max_line, "only those");
    expectEq(opts.operands[0], "f", "operand");
    let long = parse_args(["--max-line-length", "--bytes"]).unwrap();
    expect(long.max_line and long.bytes and !long.lines, "long names");
    expect(parse_args(["--max"]).unwrap().max_line, "--max abbreviation");
}

func test_total(): void {
    expectEq(parse_args(["--total=always"]).unwrap().total, TOTAL_ALWAYS, "always");
    expectEq(parse_args(["--total", "only"]).unwrap().total, TOTAL_ONLY, "separate value");
    expectEq(parse_args(["--tot=n"]).unwrap().total, TOTAL_NEVER, "prefixes");
    expectEq(parse_total("al").unwrap(), TOTAL_ALWAYS, "al");
    expect(parse_total("a").unwrap_err().startsWith("ambiguous argument 'a' for '--total'"), "a is ambiguous");
    expectEq(
        parse_total("x").unwrap_err(),
        "invalid argument 'x' for '--total'\nValid arguments are:\n  - 'auto'\n  - 'always'\n  - 'only'\n  - 'never'",
        "invalid",
    );
}

func test_operands(): void {
    let opts = parse_args(["a", "-l", "-", "--", "-w"]).unwrap();
    expect(opts.lines and !opts.words, "-w after -- is an operand");
    expectEq(opts.operands.len(), 3, "a, -, -w");
}

func test_long_names(): void {
    expectEq(match_long("w", "--w", long_names()).unwrap(), "words", "prefix");
    expectEq(
        match_long("", "--", long_names()).unwrap_err().startsWith("option '--' is ambiguous"),
        true,
        "empty matches everything",
    );
}

func test_usage_errors(): void {
    expectEq(parse_args(["-x"]).unwrap_err(), "invalid option -- 'x'", "short");
    expectEq(parse_args(["--frob"]).unwrap_err(), "unrecognized option '--frob'", "long");
    expectEq(parse_args(["--lines=2"]).unwrap_err(), "option '--lines' doesn't allow an argument", "argument");
    expectEq(parse_args(["--total"]).unwrap_err(), "option '--total' requires an argument", "missing value");
}

func test_help_stops_parsing(): void {
    expect(parse_args(["--help", "-x"]).unwrap().help, "--help first");
    expect(parse_args(["--vers"]).unwrap().version, "--vers");
}
